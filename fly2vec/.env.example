# Fly2Vec 환경 변수
# 이 파일을 .env로 복사하여 사용하세요.

# === 필수 ===

# LLM 백엔드 선택: groq | openai | claude | gemini
LLM_BACKEND=groq

# Groq (무료, Llama 3.3 70B)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (LLM_BACKEND=openai)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (LLM_BACKEND=claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Google (LLM_BACKEND=gemini)
GEMINI_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Qdrant
QDRANT_URL=http://qdrant-fly2vec:6333

# === 선택 ===

# MapBox (경로 A: 자연어 입력 시)
MAPBOX_ACCESS_TOKEN=pk.your-token-here

# 로깅
FLY2VEC_LOG_LEVEL=INFO

# MCP 서버 포트
GRAPH_EMBEDDING_MCP_PORT=8050
SWARM_ANALYSIS_MCP_PORT=8051
AGENT_PORT=8060
